#!/usr/bin/env node

// Termux CLI - Main entrypoint
// Usage: warnet <command> [args...]

import { Command } from 'commander';
import { readFileSync } from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';
import os from 'os';
import { exec } from 'child_process';
import { promisify } from 'util';
import fs from 'fs/promises';

const execAsync = promisify(exec);
const __dirname = path.dirname(fileURLToPath(import.meta.url));
const pkg = JSON.parse(readFileSync(path.join(__dirname, '../package.json'), 'utf-8'));

const program = new Command();

program
  .name('warnetech')
  .description('Claude Command CLI for Termux')
  .version(pkg.version);

// Load config
async function loadConfig() {
  const configPath = path.join(os.homedir(), '.claude-cli', 'config.json');
  try {
    const data = await fs.readFile(configPath, 'utf-8');
    return JSON.parse(data);
  } catch (error) {
    return { worker_url: 'http://localhost:8787', api_key: 'dev-key' };
  }
}

// Send request to Worker
async function sendToWorker(command, args = [], config = null) {
  if (!config) config = await loadConfig();

  const workerUrl = config.worker_url || 'http://localhost:8787';
  const apiKey = config.api_key || 'dev-key';

  const payload = {
    command,
    args,
    encrypted: false,
  };

  try {
    const response = await fetch(`${workerUrl}/cli`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-API-Key': apiKey,
        'X-Request-ID': `req-${Date.now()}`,
        'X-Timestamp': new Date().toISOString(),
      },
      body: JSON.stringify(payload),
    });

    const data = await response.json();
    return { ok: response.ok, status: response.status, data };
  } catch (error) {
    return { ok: false, error: error.message };
  }
}

// Ping command - Test connectivity with Worker
program
  .command('ping')
  .description('Check connectivity with Worker')
  .action(async () => {
    try {
      const config = await loadConfig();
      console.log('> Checking Worker connectivity...');
      const { ok, data, error } = await sendToWorker('ping', [], config);

      if (!ok) {
        console.log('✗ Error: Failed to connect to Worker');
        console.log(`  Reason: ${error || data?.error}`);
        process.exit(1);
      }

      console.log('✓ Ping: Connected');
      console.log(`  Worker: ${config.worker_url}`);
      console.log(`  Message: ${data.data.message}`);
      console.log(`  Latency: ${Date.now() - new Date(data.timestamp).getTime()}ms`);
    } catch (error) {
      console.log('✗ Error: Unexpected error');
      console.log(`  ${error.message}`);
      process.exit(1);
    }
  });

