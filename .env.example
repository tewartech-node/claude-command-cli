# Brain Network Configuration
# Copy to .env and fill in your details

# Email Configuration (Gmail)
GMAIL_USER=jasoensyd26@gmail.com
GMAIL_PASSWORD=your-gmail-password-here
GMAIL_APP_PASSWORD=your-gmail-app-password

# AI Providers
GROQ_API_KEY=gsk_your-groq-key-here
TOGETHER_API_KEY=your-together-key
HF_API_KEY=hf_your-huggingface-token

# Database
DB_PASSWORD=brainpass123
DATABASE_URL=postgresql://brain:brainpass123@postgres:5432/brain_metrics

# Brain Configuration
BRAIN_NAME=coordinator-main
BRAIN_ROLE=coordinator
DEVICE_ID=coordinator-main
MONTHLY_BUDGET=0.0

# Monitoring
MONITOR_INTERVAL=300
TRAFFIC_MONITOR_INTERVAL=60

# Dashboard
DASHBOARD_PORT=3000
BRAIN_COORDINATOR_URL=http://brain-coordinator:8000

# Network
REDIS_URL=redis://redis:6379
ENABLE_GMAIL_LEARNING=true
ENABLE_TRAFFIC_ANALYSIS=true
